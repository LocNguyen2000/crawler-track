# Backend HTTP port
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/crawlers

# Authentication signing key (generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))")
AUTH_JWT_SECRET=

# Frontend URL used by legacy verification emails
APP_BASE_URL=http://localhost:5173

# EmailJS verification template is only used for legacy accounts; the signup
# flow does not send verification emails.
EMAILJS_SERVICE_ID=service_ywvscwl
EMAILJS_TEMPLATE_ID=
EMAILJS_NOTIFICATION_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Refresh-cookie settings (use Secure=true and SameSite=none for cross-site HTTPS deployments)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Optional migration source override (defaults to MONGODB_URI)
MONGODB_SOURCE_URI=mongodb://localhost:27017/crawlers

# Remote MongoDB URI for `npm run db:migrate`
MONGODB_TARGET_URI=mongodb://localhost:27018/crawlers

# Comma-separated frontend origins allowed to call the backend
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Optional browser executable path (leave empty to use Puppeteer's bundled browser)
PUPPETEER_EXECUTABLE_PATH=

# Set to true in Vercel project build environment to skip downloading local Chrome
PUPPETEER_SKIP_DOWNLOAD=false

# Default headless mode for crawler runs without a saved per-crawler setting
PUPPETEER_HEADLESS=true

# Set true when Chromium needs to run without the sandbox (for example, in Docker)
PUPPETEER_NO_SANDBOX=false
